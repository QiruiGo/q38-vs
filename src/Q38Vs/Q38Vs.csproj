      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="ChatPage\chat.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
