      <Link>WebView2Loader.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
    </None>
  </ItemGroup>
  <Import Project="$(MSBuildBinPath)\Microsoft.CSharp.targets" />
  <Import Project="$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets" Condition="Exists('$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets')" />
  <!-- pkgdef CodeBase injection: without it VS can't resolve Q38Vs.dll on installs where
       the extension catalog probing path is stale (FileNotFoundException, 2026-10-31). -->
  <Target Name="PatchPkgDefCodeBase" AfterTargets="Build">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\scripts\patch-pkgdef.ps1&quot; -PkgDefPath &quot;$(TargetDir)$(TargetName).pkgdef&quot; -VsixPath &quot;$(TargetDir)$(TargetName).vsix&quot;" />
  </Target>
